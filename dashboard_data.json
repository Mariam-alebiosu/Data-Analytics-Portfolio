<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Contact Centre Performance Dashboard</title>
<style>
:root {
  --bg:#0b1220; --panel:#121b2e; --panel2:#18243a; --text:#eef4ff;
  --muted:#9db0cc; --accent:#4aa3ff; --accent2:#68d6c1; --danger:#ff7b7b;
  --grid:#27344c; --good:#77d58b;
}
* { box-sizing:border-box; }
body {
  margin:0; font-family:Inter,Segoe UI,Arial,sans-serif; background:var(--bg); color:var(--text);
}
.container { max-width:1500px; margin:auto; padding:24px; }
.header { display:flex; justify-content:space-between; gap:20px; align-items:flex-end; flex-wrap:wrap; }
h1 { margin:0; font-size:30px; letter-spacing:.2px; }
.subtitle { color:var(--muted); margin-top:6px; }
.filters { display:grid; grid-template-columns:repeat(5,minmax(150px,1fr)); gap:10px; margin:20px 0; }
select, button {
  width:100%; background:var(--panel); color:var(--text); border:1px solid var(--grid);
  border-radius:10px; padding:10px 12px; font-size:14px;
}
button { cursor:pointer; }
.kpis { display:grid; grid-template-columns:repeat(7,1fr); gap:12px; }
.card {
  background:linear-gradient(180deg,var(--panel),var(--panel2)); border:1px solid var(--grid);
  border-radius:14px; padding:16px; box-shadow:0 8px 24px rgba(0,0,0,.18);
}
.kpi-label { color:var(--muted); font-size:12px; text-transform:uppercase; letter-spacing:.6px; }
.kpi-value { font-size:26px; font-weight:700; margin-top:8px; }
.grid2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:14px; }
.chart-card { min-height:360px; }
.chart-title { font-weight:700; margin-bottom:4px; }
.chart-subtitle { color:var(--muted); font-size:12px; margin-bottom:10px; }
svg { width:100%; height:290px; overflow:visible; }
.axis text { fill:var(--muted); font-size:11px; }
.axis line, .axis path { stroke:var(--grid); }
.tooltip {
  position:fixed; pointer-events:none; background:#07101d; color:white; border:1px solid var(--grid);
  padding:8px 10px; border-radius:8px; font-size:12px; display:none; z-index:99;
}
.bar { fill:var(--accent); cursor:pointer; }
.bar:hover { opacity:.8; }
.line { fill:none; stroke:var(--accent2); stroke-width:3; }
.point { fill:var(--accent2); cursor:pointer; }
.table-wrap { overflow:auto; max-height:330px; }
table { width:100%; border-collapse:collapse; font-size:13px; }
th,td { padding:10px; border-bottom:1px solid var(--grid); text-align:right; }
th:first-child, td:first-child { text-align:left; }
th { position:sticky; top:0; background:var(--panel); color:var(--muted); }
.insight {
  margin-top:14px; padding:14px 16px; border-left:3px solid var(--accent2);
  background:var(--panel); border-radius:10px; color:#dce9fb;
}
.small { color:var(--muted); font-size:12px; }
@media (max-width:1100px) {
  .kpis { grid-template-columns:repeat(4,1fr); }
  .filters { grid-template-columns:repeat(2,1fr); }
}
@media (max-width:760px) {
  .grid2 { grid-template-columns:1fr; }
  .kpis { grid-template-columns:repeat(2,1fr); }
  .filters { grid-template-columns:1fr; }
}
</style>
</head>
<body>
<div class="container">
  <div class="header">
    <div>
      <h1>Contact Centre Performance Dashboard</h1>
      <div class="subtitle">Interactive portfolio dashboard • synthetic data • SQL + BI storytelling</div>
    </div>
    <div class="small">Click bars to filter • Hover for detail</div>
  </div>

  <div class="filters">
    <select id="month"><option value="">All Months</option></select>
    <select id="channel"><option value="">All Channels</option></select>
    <select id="team"><option value="">All Teams</option></select>
    <select id="reason"><option value="">All Contact Reasons</option></select>
    <button id="reset">Reset Filters</button>
  </div>

  <div class="kpis">
    <div class="card"><div class="kpi-label">Contacts</div><div class="kpi-value" id="k_contacts">—</div></div>
    <div class="card"><div class="kpi-label">CSAT</div><div class="kpi-value" id="k_csat">—</div></div>
    <div class="card"><div class="kpi-label">AHT</div><div class="kpi-value" id="k_aht">—</div></div>
    <div class="card"><div class="kpi-label">ASA</div><div class="kpi-value" id="k_asa">—</div></div>
    <div class="card"><div class="kpi-label">FCR</div><div class="kpi-value" id="k_fcr">—</div></div>
    <div class="card"><div class="kpi-label">Abandonment</div><div class="kpi-value" id="k_aband">—</div></div>
    <div class="card"><div class="kpi-label">SLA ≤120s</div><div class="kpi-value" id="k_sla">—</div></div>
  </div>

  <div class="grid2">
    <div class="card chart-card">
      <div class="chart-title">Monthly Contact Volume</div>
      <div class="chart-subtitle">Interactions by month</div>
      <svg id="volumeChart"></svg>
    </div>
    <div class="card chart-card">
      <div class="chart-title">Monthly CSAT Trend</div>
      <div class="chart-subtitle">Average survey score</div>
      <svg id="csatChart"></svg>
    </div>
  </div>

  <div class="grid2">
    <div class="card chart-card">
      <div class="chart-title">Contact Reason Analysis</div>
      <div class="chart-subtitle">Volume by reason • click a bar to filter</div>
      <svg id="reasonChart"></svg>
    </div>
    <div class="card chart-card">
      <div class="chart-title">Channel Performance</div>
      <div class="chart-subtitle">Average wait time by channel • click a bar to filter</div>
      <svg id="channelChart"></svg>
    </div>
  </div>

  <div class="grid2">
    <div class="card chart-card">
      <div class="chart-title">Wait Time vs CSAT</div>
      <div class="chart-subtitle">Average satisfaction across wait-time bands</div>
      <svg id="waitChart"></svg>
    </div>
    <div class="card chart-card">
      <div class="chart-title">Hourly Demand & Abandonment</div>
      <div class="chart-subtitle">Bar = contacts, line = abandonment rate</div>
      <svg id="hourChart"></svg>
    </div>
  </div>

  <div class="card" style="margin-top:14px">
    <div class="chart-title">Team Performance</div>
    <div class="chart-subtitle">Operational comparison under the current filters</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Team</th><th>Contacts</th><th>Avg Wait</th><th>AHT</th><th>FCR</th><th>Abandon</th><th>CSAT</th></tr></thead>
        <tbody id="teamTable"></tbody>
      </table>
    </div>
  </div>

  <div class="insight" id="insight"></div>
</div>
<div class="tooltip" id="tooltip"></div>

<script>
let DATA = [];
const $ = id => document.getElementById(id);
const tooltip = $("tooltip");

function uniq(key) {
  return [...new Set(DATA.map(d => d[key]))].sort();
}
function populate(id,key) {
  const el=$(id);
  uniq(key).forEach(v=>{ const o=document.createElement("option"); o.value=v; o.textContent=v; el.appendChild(o); });
}
populate("month","month"); populate("channel","channel"); populate("team","team"); populate("reason","reason");

function currentData() {
  const m=$("month").value,c=$("channel").value,t=$("team").value,r=$("reason").value;
  return DATA.filter(d=>(!m||d.month===m)&&(!c||d.channel===c)&&(!t||d.team===t)&&(!r||d.reason===r));
}
function mean(arr) {
  const v=arr.filter(x=>x!==null&&!Number.isNaN(x));
  return v.length ? v.reduce((a,b)=>a+b,0)/v.length : 0;
}
function pct(x) { return (x*100).toFixed(1)+"%"; }
function secFmt(s) { return Math.round(s)+"s"; }
function minFmt(s) { return (s/60).toFixed(1)+"m"; }
function group(data,key) {
  const m=new Map();
  data.forEach(d=>{ const k=d[key]; if(!m.has(k))m.set(k,[]); m.get(k).push(d); });
  return [...m.entries()].map(([key,rows])=>({key,rows}));
}
function clear(svg) { svg.innerHTML=""; }
function size(svg) {
  return {w:svg.clientWidth||600,h:290,ml:52,mr:20,mt:15,mb:55};
}
function showTip(e,html) {
  tooltip.innerHTML=html; tooltip.style.display="block";
  tooltip.style.left=(e.clientX+12)+"px"; tooltip.style.top=(e.clientY+12)+"px";
}
function hideTip() { tooltip.style.display="none"; }

function drawBar(svgId, items, valueFn, labelFn, tipFn, clickFn) {
  const svg=$(svgId); clear(svg); const s=size(svg), ns="http://www.w3.org/2000/svg";
  const vals=items.map(valueFn), max=Math.max(...vals,1);
  const pw=s.w-s.ml-s.mr, ph=s.h-s.mt-s.mb, gap=8, bw=Math.max(8,(pw-gap*(items.length-1))/items.length);
  items.forEach((it,i)=>{
    const v=valueFn(it), bh=ph*v/max, x=s.ml+i*(bw+gap), y=s.mt+ph-bh;
    const rect=document.createElementNS(ns,"rect"); rect.setAttribute("x",x); rect.setAttribute("y",y);
    rect.setAttribute("width",bw); rect.setAttribute("height",bh); rect.setAttribute("rx",4); rect.setAttribute("class","bar");
    rect.addEventListener("mousemove",e=>showTip(e,tipFn(it))); rect.addEventListener("mouseleave",hideTip);
    if(clickFn) rect.addEventListener("click",()=>clickFn(it));
    svg.appendChild(rect);
    const tx=document.createElementNS(ns,"text"); tx.setAttribute("x",x+bw/2); tx.setAttribute("y",s.mt+ph+18);
    tx.setAttribute("text-anchor","middle"); tx.setAttribute("fill","#9db0cc"); tx.setAttribute("font-size","10");
    const lab=labelFn(it); tx.textContent=lab.length>16?lab.slice(0,14)+"…":lab; svg.appendChild(tx);
  });
}

function drawLine(svgId, items, valueFn, labelFn, tipFn) {
  const svg=$(svgId); clear(svg); const s=size(svg), ns="http://www.w3.org/2000/svg";
  const vals=items.map(valueFn), min=Math.min(...vals), max=Math.max(...vals), range=(max-min)||1;
  const pw=s.w-s.ml-s.mr, ph=s.h-s.mt-s.mb;
  const pts=items.map((it,i)=>{
    const x=s.ml+(items.length===1?pw/2:i*pw/(items.length-1));
    const y=s.mt+ph-(valueFn(it)-min)/range*ph;
    return [x,y,it];
  });
  const p=document.createElementNS(ns,"path");
  p.setAttribute("d",pts.map((q,i)=>(i?"L":"M")+q[0]+","+q[1]).join(" "));
  p.setAttribute("class","line"); svg.appendChild(p);
  pts.forEach(([x,y,it])=>{
    const c=document.createElementNS(ns,"circle"); c.setAttribute("cx",x); c.setAttribute("cy",y); c.setAttribute("r",5); c.setAttribute("class","point");
    c.addEventListener("mousemove",e=>showTip(e,tipFn(it))); c.addEventListener("mouseleave",hideTip); svg.appendChild(c);
    const tx=document.createElementNS(ns,"text"); tx.setAttribute("x",x); tx.setAttribute("y",s.mt+ph+18); tx.setAttribute("text-anchor","middle");
    tx.setAttribute("fill","#9db0cc"); tx.setAttribute("font-size","10"); tx.textContent=labelFn(it); svg.appendChild(tx);
  });
}

function update() {
  const d=currentData();
  $("k_contacts").textContent=d.length.toLocaleString();
  $("k_csat").textContent=mean(d.map(x=>x.csat)).toFixed(2);
  $("k_aht").textContent=minFmt(mean(d.map(x=>x.handle)));
  $("k_asa").textContent=secFmt(mean(d.map(x=>x.wait)));
  $("k_fcr").textContent=pct(mean(d.map(x=>x.fcr)));
  $("k_aband").textContent=pct(mean(d.map(x=>x.abandoned)));
  $("k_sla").textContent=pct(mean(d.map(x=>x.sla)));

  const byMonth=group(d,"month").sort((a,b)=>a.key.localeCompare(b.key));
  drawBar("volumeChart",byMonth,x=>x.rows.length,x=>x.key,x=>`<b>${x.key}</b><br>${x.rows.length.toLocaleString()} contacts`);
  drawLine("csatChart",byMonth,x=>mean(x.rows.map(r=>r.csat)),x=>x.key,x=>`<b>${x.key}</b><br>CSAT ${mean(x.rows.map(r=>r.csat)).toFixed(2)}`);

  const byReason=group(d,"reason").sort((a,b)=>b.rows.length-a.rows.length);
  drawBar("reasonChart",byReason,x=>x.rows.length,x=>x.key,x=>`<b>${x.key}</b><br>${x.rows.length.toLocaleString()} contacts<br>CSAT ${mean(x.rows.map(r=>r.csat)).toFixed(2)}`, x=>{$("reason").value=x.key;update();});

  const byChannel=group(d,"channel").sort((a,b)=>mean(b.rows.map(r=>r.wait))-mean(a.rows.map(r=>r.wait)));
  drawBar("channelChart",byChannel,x=>mean(x.rows.map(r=>r.wait)),x=>x.key,x=>`<b>${x.key}</b><br>Avg wait ${secFmt(mean(x.rows.map(r=>r.wait)))}<br>CSAT ${mean(x.rows.map(r=>r.csat)).toFixed(2)}`, x=>{$("channel").value=x.key;update();});

  const bands=[
    ["0-60",0,60],["61-120",61,120],["121-180",121,180],["181-300",181,300],["300+",301,99999]
  ].map(([label,a,b])=>{const rows=d.filter(r=>r.wait>=a&&r.wait<=b);return {key:label,rows};});
  drawBar("waitChart",bands,x=>mean(x.rows.map(r=>r.csat)),x=>x.key,x=>`<b>${x.key} sec</b><br>CSAT ${mean(x.rows.map(r=>r.csat)).toFixed(2)}<br>Abandon ${pct(mean(x.rows.map(r=>r.abandoned)))}`);

  const byHour=group(d,"hour").sort((a,b)=>a.key-b.key);
  drawBar("hourChart",byHour,x=>x.rows.length,x=>String(x.key),x=>`<b>${x.key}:00</b><br>${x.rows.length} contacts<br>Abandon ${pct(mean(x.rows.map(r=>r.abandoned)))}`);

  const teams=group(d,"team").sort((a,b)=>b.rows.length-a.rows.length);
  $("teamTable").innerHTML=teams.map(x=>`<tr>
    <td>${x.key}</td><td>${x.rows.length.toLocaleString()}</td>
    <td>${secFmt(mean(x.rows.map(r=>r.wait)))}</td><td>${minFmt(mean(x.rows.map(r=>r.handle)))}</td>
    <td>${pct(mean(x.rows.map(r=>r.fcr)))}</td><td>${pct(mean(x.rows.map(r=>r.abandoned)))}</td>
    <td>${mean(x.rows.map(r=>r.csat)).toFixed(2)}</td></tr>`).join("");

  const highWait=byChannel[0];
  const worstReason=[...byReason].sort((a,b)=>mean(a.rows.map(r=>r.csat))-mean(b.rows.map(r=>r.csat)))[0];
  $("insight").innerHTML=d.length ? `<b>Current view:</b> ${d.length.toLocaleString()} interactions. 
    ${highWait.key} has the highest average wait (${secFmt(mean(highWait.rows.map(r=>r.wait)))}).
    ${worstReason.key} has the lowest CSAT among visible contact reasons (${mean(worstReason.rows.map(r=>r.csat)).toFixed(2)}/5).`
    : "No records match the selected filters.";
}

["month","channel","team","reason"].forEach(id=>$(id).addEventListener("change",update));
$("reset").addEventListener("click",()=>{["month","channel","team","reason"].forEach(id=>$(id).value="");update();});
window.addEventListener("resize",()=>{ if (DATA.length) update(); });

async function loadDashboardData() {
  const insight = $("insight");
  insight.innerHTML = "<b>Loading dashboard data…</b>";
  try {
    const response = await fetch("dashboard_data.json");
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    DATA = await response.json();
    update();
  } catch (err) {
    insight.innerHTML = `<b>Dashboard data could not be loaded.</b> This dashboard is designed to be served from GitHub Pages or another web server. Error: ${err.message}`;
    console.error(err);
  }
}

loadDashboardData();
</script>
</body>
</html>
